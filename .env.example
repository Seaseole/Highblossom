APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Laravel passes this straight to the session and XSRF cookies with no fallback:
# an absent key leaves both unflagged Secure, so HTTPS hosts must set it.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Media never resolves through this disk - see PUBLIC_DISK_DRIVER below.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Object storage (Laravel Cloud Object Storage / any S3-compatible bucket)
# ---------------------------------------------------------------------------
# PUBLIC_DISK_DRIVER drives the "public" disk, which is where every uploaded
# image, video and document is stored. Use "local" in development and "s3" in
# production so media survives deployments instead of living on the ephemeral
# instance disk. All upload code targets the disk by name, never the driver.
PUBLIC_DISK_DRIVER=local

# Never commit real credentials. In production these are Laravel Cloud shared
# secrets; AWS_DEFAULT_REGION must be "auto" for Cloud Object Storage and
# AWS_URL is the bucket's public read URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# AI-assisted authoring suggestions (post titles and available usernames)
# ---------------------------------------------------------------------------
# Off by default. Turning this on sends redacted draft text to a third-party
# provider, so enable it only after the data-processing terms are agreed.
# Without a key the offline client answers with deterministic local candidates:
# nothing leaves the server and the test suite never touches the network.
# Set AI_SUGGESTIONS_PROVIDER=null to force that behaviour with a key present.
# Never commit a real key here; use shared secrets in production.
# TIMEOUT is the whole completion budget, not just the connection: slow or
# free-tier models routinely need 5-15s to produce a first token. A value as
# low as 3 makes a healthy provider look broken ("Suggestions are unavailable").
# MAX_TOKENS is a ceiling, not a fixed spend. Reasoning models (e.g. some
# OpenRouter :free models) consume it on an internal `reasoning` field first;
# at 300 they answer HTTP 200 with content=null and finish_reason=length.
# Keep 700+ for those, or use a non-reasoning/instruct model.
# Any OpenAI-compatible chat-completions endpoint works, e.g. OpenRouter:
#   AI_SUGGESTIONS_BASE_URL=https://openrouter.ai/api/v1
# After changing these, run `php artisan config:clear` (or re-warm config:cache).
AI_SUGGESTIONS_ENABLED=false
AI_SUGGESTIONS_PROVIDER=openai-compatible
AI_SUGGESTIONS_KEY=
AI_SUGGESTIONS_BASE_URL=https://api.openai.com/v1
AI_SUGGESTIONS_MODEL=gpt-4o-mini
AI_SUGGESTIONS_TIMEOUT=20
AI_SUGGESTIONS_MAX_TOKENS=700
AI_SUGGESTIONS_TEMPERATURE=0.7
AI_SUGGESTIONS_RATE_LIMIT=10
AI_SUGGESTIONS_CACHE_TTL=300

VITE_APP_NAME="${APP_NAME}"
