# Dependencies — installed on deploy, never committed
/vendor
/node_modules
/public/hot
/public/storage

# Build output (regenerated by `npm run build`)
/public/build

# Environment — never the real .env, keep the example
/.env
/.env.*
!/.env.example

# Composer / auth artifacts
/auth.json

# Local databases
/database/*.sqlite
/database/*.sqlite-journal
/highblssom

# Editors & OS
/.idea
/.vscode
/.fleet
/.nova
/.zed
/.windsurf
/.junie
/.cursor
.DS_Store
Thumbs.db

# Tooling caches
/.phpunit.cache
/.phpunit.result.cache
.phpactor.json
/Homestead.json
/Homestead.yaml
npm-debug.log
yarn-error.log

# Tests are for local development only and are not shipped to production
/tests
/phpunit.xml

# AI-tooling and planning scratch
/.agents
/.devin
/.ai
/.kilo
/PRD.md
/GEMINI.md
/CHANGELOG-*.md
/qodana.yaml
/boost.json
/routes_output.txt
/routes_debug.json

# Storage that leaked into the repo (the real skeleton uses per-dir .gitignore files)
/storage/framework/bootstrap-cache-backup*
/storage/framework/session-audit.php
/storage/*.key
/storage/pail

# Junk / generated file types that should never be tracked
*.map
*.zip
*.sql
*.sql.gz
*.tar
*.tar.gz
*.bak
*.log
/backups
/public/favicon-version.txt
